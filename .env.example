# Copy to .env and fill in. .env is git-ignored.

# Garmin Connect login (used only when connecting from Settings; tokens are cached in data/garmin_tokens/)
GARMIN_EMAIL=
GARMIN_PASSWORD=

# Free key from https://api.data.gov/signup/ (USDA FoodData Central)
USDA_API_KEY=

# LLM backend: "subscription" uses your Claude Code login (Max plan); "api" uses ANTHROPIC_API_KEY
GWC_LLM_BACKEND=subscription
# Only needed for GWC_LLM_BACKEND=api. Leave unset otherwise so subscription usage isn't billed to a key.
# ANTHROPIC_API_KEY=

# Web server. Keep 127.0.0.1 and use `tailscale serve` for phone access.
GWC_HOST=127.0.0.1
GWC_PORT=8060

# IANA time zone, e.g. America/New_York. Blank = system time zone.
GWC_TZ=

# Where the database, tokens, logs and backups live. Blank = ./data
# GWC_DATA_DIR=
